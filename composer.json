{
    "name": "skrjwsk/agent-monitor",
    "description": "Local session inspector for Claude Code agents: timeline, cost, permissions and boundary violations",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:8090 -t public public/index.php"
        ],
        "demo": "php bin/demo.php",
        "test": "php tests/run.php",
        "smoke": "php tests/smoke.php",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@test",
            "@smoke",
            "@phpstan"
        ]
    },
    "config": {
        "lock": false
    }
}
