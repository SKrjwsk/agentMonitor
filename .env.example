# Copy to the dotenv file (same name without ".example") and adjust.
# Agent work boundary: comma-separated paths, ~ = home directory, matched by path prefix.
# Touching a path outside both lists is a violation.

# Read and write. In the last path (Claude Code scratchpad) replace 1000 with your own UID (`id -u`)
AGENT_ALLOWED_RW=~/code,~/.claude/projects,~/.claude/plans,/tmp/claude-1000

# Read only (writing = violation)
AGENT_ALLOWED_R=~/.claude/skills,~/.claude/plugins

# Parent directories whose .claude/settings.json is inherited by sessions below them (outermost first).
# Empty by default: only user, project and local settings are read.
AGENT_INHERITED_SETTINGS_DIRS=
