# Skopiuj do .env i dopasuj do siebie.
# Granica pracy agentów: ścieżki po przecinku, ~ = katalog domowy, dopasowanie po początku ścieżki.
# Dotknięcie ścieżki spoza obu list to naruszenie.

# Odczyt i zapis. 501 zamień na własny UID (`id -u`) — to scratchpad Claude Code
AGENT_ALLOWED_RW=~/SK,~/MEGA/OFFLINE_DATABASE,~/.claude/projects,~/.claude/plans,/private/tmp/claude-501

# Tylko odczyt (zapis = naruszenie)
AGENT_ALLOWED_R=~/.claude/skills,~/.claude/plugins
